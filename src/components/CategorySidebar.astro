---
import { CATS, ICONS, TOOLS } from '../data/tools.js';

const { active = 'all' } = Astro.props;
const counts: Record<string, number> = {};
TOOLS.forEach(tool => {
  (tool.categories || [tool.cat]).forEach((category: string) => {
    counts[category] = (counts[category] || 0) + 1;
  });
});
---
<aside class="sidebar" id="categories">
  <div class="sidebar-label">Categories</div>
  <div class="cat-list">
    <a class={`cat-row${active === 'all' ? ' active' : ''}`} href="/tools/">
      <span class="icon" aria-hidden="true">{ICONS.all}</span>
      <span class="label">All Tools</span>
      <span class="count">{TOOLS.length}</span>
    </a>
    {Object.keys(CATS).map(categoryId => (
      <a class={`cat-row${active === categoryId ? ' active' : ''}`} href={`/category/${categoryId}/`}>
        <span class="icon" aria-hidden="true">{ICONS[categoryId] || '•'}</span>
        <span class="label">{CATS[categoryId].label}</span>
        <span class="count">{counts[categoryId] || 0}</span>
      </a>
    ))}
  </div>
</aside>
