---
import { ExternalLink, MessageSquareQuote, ThumbsUp } from '@lucide/astro';

const { mentions = [], toolName, isDemo = false } = Astro.props;
const sourceLabels = { x:'X', youtube:'YouTube', linkedin:'LinkedIn', trustpilot:'Trustpilot', g2:'G2', producthunt:'Product Hunt', other:'Web' };
const sourceMarks = { x:'𝕏', youtube:'▶', linkedin:'in', trustpilot:'★', g2:'G2', producthunt:'P', other:'↗' };
const initials = name => String(name || '?').split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase();
---

<section class="social-proof-section" aria-labelledby="social-proof-title">
  <div class="social-proof-heading">
    <span class="tool-section-icon"><MessageSquareQuote size={18} strokeWidth={2} aria-hidden="true" /></span>
    <div><h2 id="social-proof-title">What people say about {toolName}</h2><p>Public conversations, demonstrations and reviews—with a direct path back to every source.</p></div>
  </div>
  {isDemo && <div class="social-demo-banner"><strong>Design-review content</strong><span>These sample mentions demonstrate the layout only and must be replaced with sourced excerpts.</span></div>}
  {mentions.length ? (
    <div class="mention-wall">
      {mentions.map(mention => (
        <article class={`mention-card source-${mention.source}`}>
          <div class="mention-person-row">
            <span class="mention-avatar" aria-hidden="true">{initials(mention.author)}</span>
            <div class="mention-identity"><strong>{mention.handle || mention.author}</strong><span>{mention.context || sourceLabels[mention.source] || 'Public mention'}</span></div>
            <span class="mention-platform" title={sourceLabels[mention.source] || 'Web'}>{sourceMarks[mention.source] || '↗'}</span>
          </div>
          <p class="mention-text">{mention.text}</p>
          <div class="mention-card-foot">
            <span class="mention-engagement">{mention.engagement != null && <><ThumbsUp size={13} strokeWidth={1.9} aria-hidden="true" />{mention.engagement}</>}</span>
            <a href={mention.url} target="_blank" rel="noopener" aria-label={`View ${sourceLabels[mention.source] || 'web'} source from ${mention.author}`}>Source <ExternalLink size={13} strokeWidth={2} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="social-proof-empty"><MessageSquareQuote size={24} strokeWidth={1.8} aria-hidden="true" /><div><h3>No sourced mentions listed yet</h3><p>We’re collecting public conversations from X, YouTube, LinkedIn, Product Hunt, G2 and Trustpilot.</p></div></div>
  )}
</section>
