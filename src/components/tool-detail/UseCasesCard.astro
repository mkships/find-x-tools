---
import { BarChart3, CalendarDays, PenLine, Sparkles, Target } from '@lucide/astro';

const { items = [] } = Astro.props;
const icons = { write: PenLine, calendar: CalendarDays, sparkles: Sparkles, analytics: BarChart3 };
---

{items.length > 0 && (
  <section class="tool-section-card" aria-labelledby="tool-use-cases-title">
    <div class="tool-section-heading">
      <span class="tool-section-icon"><Target size={18} strokeWidth={2} aria-hidden="true" /></span>
      <div><h2 id="tool-use-cases-title">What you can do with it</h2><p>Practical outcomes this tool is designed to support.</p></div>
    </div>
    <div class="use-case-grid">
      {items.map(item => {
        const Icon = icons[item.icon] || Target;
        return (
          <article class="use-case-item">
            <span class="use-case-icon"><Icon size={18} strokeWidth={1.9} aria-hidden="true" /></span>
            <div><h3>{item.title}</h3><p>{item.description}</p></div>
          </article>
        );
      })}
    </div>
  </section>
)}
