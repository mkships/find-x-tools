---
import { CheckCircle2, Layers3 } from '@lucide/astro';

const { features = [] } = Astro.props;
---

{features.length > 0 && (
  <section class="tool-section-card" aria-labelledby="tool-features-title">
    <div class="tool-section-heading">
      <span class="tool-section-icon"><Layers3 size={18} strokeWidth={2} aria-hidden="true" /></span>
      <div><h2 id="tool-features-title">Key features</h2><p>The core capabilities available in the product.</p></div>
    </div>
    <div class="detail-feature-grid">
      {features.map(feature => (
        <div class="detail-feature-item"><CheckCircle2 size={17} strokeWidth={2.1} aria-hidden="true" /><span>{feature}</span></div>
      ))}
    </div>
  </section>
)}
