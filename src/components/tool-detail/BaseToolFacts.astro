---
import { Info, Tags } from '@lucide/astro';
import { API_STATUS, JOBS, NETWORKS, PRICE_STYLES, THREAD_SUPPORT, TOOL_STATUS, X_FIT } from '../../data/tools.js';

const { tool, category, categories = [], categoryIcon = '' } = Astro.props;
const priceStyle = PRICE_STYLES[tool.price] || PRICE_STYLES.Freemium;
const answer = (value: string) => value === 'yes' ? 'Yes' : value === 'no' ? 'No' : 'Not confirmed';
---

<div class="tool-base-sidebar-stack">
  <section class="tool-base-facts-card" aria-labelledby="base-facts-title">
    <div class="tool-section-heading compact">
      <span class="tool-section-icon"><Info size={18} stroke-width={2} aria-hidden="true" /></span>
      <div><h2 id="base-facts-title">Tool details</h2></div>
    </div>
    <dl class="tool-base-facts">
      <div><dt>Pricing</dt><dd><span class="price-badge" style={`background:${priceStyle.bg};color:${priceStyle.fg}`}>{tool.price}</span></dd></div>
      <div><dt>X-fit</dt><dd>{X_FIT[tool.xFit]?.label || X_FIT.unknown.label}</dd></div>
      <div><dt>Status</dt><dd>{TOOL_STATUS[tool.status]?.label || 'Live'}</dd></div>
      <div><dt>Last checked</dt><dd>{tool.lastChecked || 'Not yet verified'}</dd></div>
      <div><dt>Starting price</dt><dd>{tool.startingPrice || tool.price}</dd></div>
      {tool.threadSupport && <div><dt>Thread support</dt><dd><strong>{THREAD_SUPPORT[tool.threadSupport]?.label}</strong> — {THREAD_SUPPORT[tool.threadSupport]?.description}</dd></div>}
      <div><dt>X access</dt><dd>{API_STATUS[tool.apiStatus]?.label || API_STATUS.unclear.label}</dd></div>
      <div><dt>Open source</dt><dd>{tool.openSource ? 'Yes' : 'No'}</dd></div>
      <div><dt>Networks</dt><dd>{(tool.networks || ['x']).map((network: keyof typeof NETWORKS) => NETWORKS[network] || network).join(' · ')}</dd></div>
      <div><dt>Primary use</dt><dd>{category.label}</dd></div>
      <div><dt>Free plan</dt><dd>{answer(tool.freePlan)}</dd></div>
      <div><dt>Mobile app</dt><dd>{answer(tool.mobileApp)}</dd></div>
      <div><dt>Developer API</dt><dd>{answer(tool.apiAccess)}</dd></div>
    </dl>
  </section>

  {tool.jobs?.length > 0 && <section class="tool-base-categories-card" aria-labelledby="tool-jobs-title">
    <div class="tool-section-heading compact">
      <span class="tool-section-icon"><Tags size={18} stroke-width={2} aria-hidden="true" /></span>
      <div><h2 id="tool-jobs-title">Jobs on X</h2></div>
    </div>
    <div class="tool-base-category-list">
      {tool.jobs.map((job: keyof typeof JOBS) => <span>{JOBS[job]?.label || job}</span>)}
    </div>
  </section>}

  <section class="tool-base-categories-card" aria-labelledby="base-categories-title">
    <div class="tool-section-heading compact">
      <span class="tool-section-icon"><Tags size={18} stroke-width={2} aria-hidden="true" /></span>
      <div><h2 id="base-categories-title">Related categories</h2></div>
    </div>
    <div class="tool-base-category-list">
      {categories.map((item: { slug: string; label: string }) => <a href={`/category/${item.slug}/`}>{item.slug === tool.cat && <span aria-hidden="true">{categoryIcon}</span>}{item.label}</a>)}
    </div>
  </section>
</div>
