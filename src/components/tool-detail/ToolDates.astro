---
import { formatListingDate } from '../../utils/dates.js';
const { listedAt, lastChecked } = Astro.props;
---

{(listedAt || lastChecked) && <section class="tool-dates" aria-label="Directory record dates">
  {listedAt && <span>Listed <time datetime={listedAt}>{formatListingDate(listedAt)}</time></span>}
  {lastChecked && <span>Last checked <time datetime={lastChecked}>{formatListingDate(lastChecked)}</time></span>}
</section>}
