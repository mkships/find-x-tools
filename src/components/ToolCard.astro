---
import { CATS, PRICE_STYLES } from '../data/tools.js';

const { tool: t } = Astro.props;
const cat = CATS[t.cat] || {};
const p = PRICE_STYLES[t.price] || PRICE_STYLES.Freemium;
const initial = (t.name || '?').trim().charAt(0).toUpperCase();
---
<a
  class="tool-card"
  href={`/tools/${t.id}/`}
  data-name={t.name.toLowerCase()}
  data-tagline={t.tagline.toLowerCase()}
  data-catlabel={(cat.label || '').toLowerCase()}
  data-cat={t.cat}
  data-price={t.price}
>
  <div class="tool-card-top">
    <div class="tile" style={`background:${t.color || '#1D9BF0'}`}>{initial}</div>
    <div class="tool-card-body">
      <div class="tool-card-title">
        <span class="name">{t.name}</span>
        {t.verified && <span class="badge-verified" title="Verified by our team — functionality and use-cases checked">✓ Verified</span>}
        {t.featured && <span class="badge-featured">★ Featured</span>}
      </div>
      <p class="tool-card-tagline">{t.tagline}</p>
    </div>
  </div>
  <div class="tool-card-foot">
    <span class="cat-chip">{cat.label || 'Tool'}</span>
    <span class="price-badge" style={`margin-left:auto;background:${p.bg};color:${p.fg}`}>{t.price || 'Freemium'}</span>
  </div>
</a>
