---
import { compareTools, JOBS, TOOLS, CATS } from '../data/tools.js';
import ToolCard from './ToolCard.astro';
import CategorySidebar from './CategorySidebar.astro';
import { ChevronRight, CreditCard, Gift, LayoutGrid, Layers } from '@lucide/astro';

const { cat = 'all' } = Astro.props;
const tools = (cat === 'all' ? [...TOOLS] : TOOLS.filter(t => t.categories.includes(cat)))
  .sort(compareTools);
const pageHeading = cat === 'all' ? 'Browse all X Tools' : `Browse ${CATS[cat].label} Tools for X`;
const pageDescription = cat === 'all'
  ? 'Discover the best tools for X creators, marketers, and agencies.'
  : `Discover the best ${CATS[cat].label.toLowerCase()} tools for growing on X.`;
const priceFilters = [
  { value: 'All', label: 'All Tools', Icon: LayoutGrid },
  { value: 'Free', label: 'Free', Icon: Gift },
  { value: 'Freemium', label: 'Freemium', Icon: Layers },
  { value: 'Paid', label: 'Paid', Icon: CreditCard }
];
---
<main class="page">
  <div class="browse-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
      {cat === 'all' ? (
        <span aria-current="page">All Tools</span>
      ) : (
        <>
          <a href="/tools/">All Tools</a>
          <ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
          <span aria-current="page">{CATS[cat].label}</span>
        </>
      )}
    </nav>
    <h1 class="page-title">{pageHeading}</h1>
    <p class="page-description">{pageDescription}</p>
  </div>

  <form class="hero-search browse-search" id="browseSearchForm" role="search">
    <input id="browseSearch" name="q" placeholder="Search X tools — e.g. Content Writing, Scheduling, Analytics" aria-label="Search X tools" />
    <button type="submit">Search</button>
  </form>

  <div class="layout-sidebar">
    <CategorySidebar active={cat} />
    <div>
      <div class="toolbar">
        <div class="seg" id="priceChips" aria-label="Filter tools by pricing">
          {priceFilters.map(({ value, label, Icon }) => (
            <button
              type="button"
              class={`seg-btn${value === 'All' ? ' active' : ''}`}
              data-price={value}
              aria-pressed={value === 'All' ? 'true' : 'false'}
            >
              <Icon size={14} stroke-width={1.9} aria-hidden="true" />
              {label}
            </button>
          ))}
        </div>
        <div class="catalog-select-filters" aria-label="More filters">
          <select id="jobFilter" aria-label="Filter by job">
            <option value="All">All jobs</option>
            {Object.entries(JOBS).map(([value, job]) => <option value={value}>{job.label}</option>)}
          </select>
          <select id="trustFilter" aria-label="Filter by X fit and verification">
            <option value="x-relevant">X-relevant tools</option>
            <option value="x-native">X-native</option>
            <option value="official-api">Official API</option>
            <option value="founder-built">Founder-built</option>
            <option value="open-source">Open source</option>
            <option value="x-only">X only</option>
            <option value="multi">Also posts elsewhere</option>
            <option value="threads-yes">Threads: Yes</option>
            <option value="threads-partial">Threads: Partial</option>
            <option value="threads-no">Threads: No</option>
            <option value="All">Include adjacent tools</option>
          </select>
        </div>
        <span class="count-label" id="resultsCount">{tools.length} tool{tools.length === 1 ? '' : 's'} found</span>
      </div>
      <div class="grid-tools" id="browseGrid">
        {tools.map(t => <ToolCard tool={t} />)}
      </div>
      <div class="empty-state hidden" id="emptyState">
        <div class="glyph">⌕</div>
        <div class="title">No tools match your filters</div>
        <p>Try clearing the search or picking another category.</p>
        <button class="btn-dark" id="clearFilters">Clear filters</button>
      </div>
    </div>
  </div>
</main>

<script>
  const grid = document.getElementById('browseGrid')!;
  const searchForm = document.getElementById('browseSearchForm') as HTMLFormElement;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const searchInput = document.getElementById('browseSearch') as HTMLInputElement;
  const priceChips = document.getElementById('priceChips')!;
  const countEl = document.getElementById('resultsCount')!;
  const emptyEl = document.getElementById('emptyState')!;
  const jobFilter = document.getElementById('jobFilter') as HTMLSelectElement;
  const trustFilter = document.getElementById('trustFilter') as HTMLSelectElement;

  let price = 'All';

  function apply() {
    const q = searchInput.value.trim().toLowerCase();
    const job = jobFilter.value;
    const trust = trustFilter.value;

    let visible = 0;
    for (const c of cards) {
      const matchQ = !q || c.dataset.name!.includes(q) || c.dataset.tagline!.includes(q) || c.dataset.catlabel!.includes(q) || c.dataset.jobs!.includes(q);
      const matchP = price === 'All' || c.dataset.price === price;
      const matchJob = job === 'All' || c.dataset.jobs!.split(' ').includes(job);
      const matchTrust = trust === 'All'
        || (trust === 'x-relevant' && ['high', 'medium'].includes(c.dataset.xFit!) && ['live', 'degraded'].includes(c.dataset.status!))
        || (trust === 'x-native' && c.dataset.xFit === 'high')
        || (trust === 'official-api' && c.dataset.apiStatus === 'official')
        || (trust === 'founder-built' && c.dataset.founderBuilt === 'true')
        || (trust === 'open-source' && c.dataset.openSource === 'true')
        || (trust === 'x-only' && c.dataset.networkScope === 'x-only')
        || (trust === 'multi' && c.dataset.networkScope === 'multi')
        || (trust === 'threads-yes' && c.dataset.threadSupport === 'native')
        || (trust === 'threads-partial' && ['split-only', 'queue-only'].includes(c.dataset.threadSupport!))
        || (trust === 'threads-no' && c.dataset.threadSupport === 'none');
      const show = matchQ && matchP && matchJob && matchTrust;
      c.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    countEl.textContent = visible + ' tool' + (visible === 1 ? '' : 's') + ' found';
    grid.classList.toggle('hidden', visible === 0);
    emptyEl.classList.toggle('hidden', visible > 0);

    const params = new URLSearchParams();
    if (q) params.set('q', searchInput.value.trim());
    if (price !== 'All') params.set('price', price);
    if (job !== 'All') params.set('job', job);
    if (trust !== 'x-relevant') params.set('filter', trust);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
  }

  searchInput.addEventListener('input', apply);
  searchForm.addEventListener('submit', event => {
    event.preventDefault();
    apply();
  });
  priceChips.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-price]');
    if (!chip) return;
    price = chip.dataset.price!;
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b === chip;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    apply();
  });
  jobFilter.addEventListener('change', apply);
  trustFilter.addEventListener('change', apply);
  document.getElementById('clearFilters')!.addEventListener('click', () => {
    searchInput.value = '';
    price = 'All';
    jobFilter.value = 'All';
    trustFilter.value = 'x-relevant';
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b.dataset.price === 'All';
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    apply();
  });

  const init = new URLSearchParams(location.search);
  if (init.get('q')) searchInput.value = init.get('q')!;
  const initPrice = init.get('price');
  if (initPrice && ['Free', 'Freemium', 'Paid'].includes(initPrice)) {
    price = initPrice;
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b.dataset.price === price;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
  }
  if (init.get('job') && Array.from(jobFilter.options).some(option => option.value === init.get('job'))) jobFilter.value = init.get('job')!;
  if (init.get('filter') && ['All', 'x-relevant', 'x-native', 'official-api', 'founder-built', 'open-source', 'x-only', 'multi', 'threads-yes', 'threads-partial', 'threads-no'].includes(init.get('filter')!)) trustFilter.value = init.get('filter')!;
  apply();
</script>
