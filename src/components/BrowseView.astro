---
import { CATS, TOOLS } from '../data/tools.js';
import ToolCard from './ToolCard.astro';
import CategorySidebar from './CategorySidebar.astro';
import { ChevronRight, CreditCard, Gift, LayoutGrid, Layers3 } from '@lucide/astro';

// cat: 'all' or a category key. All matching tools are prerendered (SEO);
// the client script only hides them for search and price filtering.
const { cat = 'all' } = Astro.props;
const tools = (cat === 'all' ? [...TOOLS] : TOOLS.filter(t => t.categories.includes(cat)))
  .sort((a, b) => b.popularityScore - a.popularityScore);
const pageHeading = cat === 'all' ? 'Browse all X Tools' : `Browse ${CATS[cat].label} Tools for X`;
const pageDescription = cat === 'all'
  ? 'Discover the best tools for X creators, marketers, and agencies.'
  : `Discover the best ${CATS[cat].label.toLowerCase()} tools for growing on X.`;
const priceFilters = [
  { value: 'All', label: 'All Tools', Icon: LayoutGrid },
  { value: 'Free', label: 'Free', Icon: Gift },
  { value: 'Freemium', label: 'Freemium', Icon: Layers3 },
  { value: 'Paid', label: 'Paid', Icon: CreditCard }
];
---
<main class="page">
  <div class="browse-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <ChevronRight size={15} strokeWidth={1.8} aria-hidden="true" />
      {cat === 'all' ? (
        <span aria-current="page">All Tools</span>
      ) : (
        <>
          <a href="/tools/">All Tools</a>
          <ChevronRight size={15} strokeWidth={1.8} aria-hidden="true" />
          <span aria-current="page">{CATS[cat].label}</span>
        </>
      )}
    </nav>
    <h1 class="page-title">{pageHeading}</h1>
    <p class="page-description">{pageDescription}</p>
  </div>

  <div class="hero-search browse-search">
    <input id="browseSearch" placeholder="Search X tools — e.g. Content Writing, Scheduling, Analytics" aria-label="Search X tools" />
    <button id="browseSearchBtn" type="button">Search</button>
  </div>

  <div class="layout-sidebar">
    <CategorySidebar active={cat} />
    <div>
      <div class="toolbar">
        <div class="seg" id="priceChips" aria-label="Filter tools by pricing">
          {priceFilters.map(({ value, label, Icon }) => (
            <button
              type="button"
              class={`seg-btn${value === 'All' ? ' active' : ''}`}
              data-price={value}
              aria-pressed={value === 'All' ? 'true' : 'false'}
            >
              <Icon size={14} strokeWidth={1.9} aria-hidden="true" />
              {label}
            </button>
          ))}
        </div>
        <span class="count-label" id="resultsCount">{tools.length} tool{tools.length === 1 ? '' : 's'} found</span>
      </div>
      <div class="grid-tools" id="browseGrid">
        {tools.map(t => <ToolCard tool={t} />)}
      </div>
      <div class="empty-state hidden" id="emptyState">
        <div class="glyph">⌕</div>
        <div class="title">No tools match your filters</div>
        <p>Try clearing the search or picking another category.</p>
        <button class="btn-dark" id="clearFilters">Clear filters</button>
      </div>
    </div>
  </div>
</main>

<script>
  const grid = document.getElementById('browseGrid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
  const searchInput = document.getElementById('browseSearch') as HTMLInputElement;
  const priceChips = document.getElementById('priceChips')!;
  const countEl = document.getElementById('resultsCount')!;
  const emptyEl = document.getElementById('emptyState')!;

  let price = 'All';

  function apply() {
    const q = searchInput.value.trim().toLowerCase();

    let visible = 0;
    for (const c of cards) {
      const matchQ = !q || c.dataset.name!.includes(q) || c.dataset.tagline!.includes(q) || c.dataset.catlabel!.includes(q);
      const matchP = price === 'All' || c.dataset.price === price;
      const show = matchQ && matchP;
      c.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    countEl.textContent = visible + ' tool' + (visible === 1 ? '' : 's') + ' found';
    grid.classList.toggle('hidden', visible === 0);
    emptyEl.classList.toggle('hidden', visible > 0);

    const params = new URLSearchParams();
    if (q) params.set('q', searchInput.value.trim());
    if (price !== 'All') params.set('price', price);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
  }

  searchInput.addEventListener('input', apply);
  document.getElementById('browseSearchBtn')!.addEventListener('click', apply);
  priceChips.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-price]');
    if (!chip) return;
    price = chip.dataset.price!;
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b === chip;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    apply();
  });
  document.getElementById('clearFilters')!.addEventListener('click', () => {
    searchInput.value = '';
    price = 'All';
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b.dataset.price === 'All';
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    apply();
  });

  // Seed controls from URL (?q=, ?price=) — used by header/hero search.
  const init = new URLSearchParams(location.search);
  if (init.get('q')) searchInput.value = init.get('q')!;
  const initPrice = init.get('price');
  if (initPrice && ['Free', 'Freemium', 'Paid'].includes(initPrice)) {
    price = initPrice;
    priceChips.querySelectorAll<HTMLElement>('.seg-btn').forEach(b => {
      const active = b.dataset.price === price;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
  }
  if (init.toString()) apply();
</script>
