---
import { SITE_NAME } from '../config.js';
import { CATS, ICONS, TOOLS } from '../data/tools.js';
import { Search } from '@lucide/astro';

const { title, description, jsonld, ogImage, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const footerCats = Object.entries(CATS);
const currentYear = new Date().getFullYear();
const jsonldBlocks = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/assets/x-black.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(ogImage || '/assets/x-black.png', Astro.site)} />
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/styles.css" />
{jsonldBlocks.map(block => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>
<div id="app">
  <header class="header">
    <div class="header-layout">
      <div class="header-left">
        <a class="logo" href="/" style="text-decoration:none">
          <div class="logo-badge"><img src="/assets/x-white.png" alt={SITE_NAME + ' logo'} /></div>
          <span class="logo-text">Tools<span> Directory</span></span>
        </a>
      </div>
      <nav class="header-center nav">
        <a class="nav-link" href="/tools/">Browse Tools</a>
        <a class="nav-link" href="/categories/">Categories</a>
        <a class="nav-link" href="/about/">About</a>
      </nav>
      <div class="header-right">
        <div class="search-pill">
          <Search class="search-icon" size={18} strokeWidth={1.75} aria-hidden="true" />
          <input id="headerSearch" placeholder="Search tools" aria-label="Search tools" />
        </div>
        <a class="btn-submit-header" href="/submit/">Submit a Tool</a>
      </div>
    </div>
  </header>

  <slot />

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-logo">
          <div class="footer-logo-badge"><img src="/assets/x-black.png" alt="" /></div>
          <span class="footer-logo-text">Tools<span> Directory</span></span>
        </div>
        <p>A practical, independent directory for finding tools that support real workflows on X. Not affiliated with X Corp.</p>
        <div class="footer-status-row">
          <span class="footer-catalog-summary">{TOOLS.length} tools · {footerCats.length} categories</span>
          <span class="footer-updated-status"><span class="footer-status-dot" aria-hidden="true"></span>Updated weekly</span>
        </div>
      </div>
      <div class="footer-category-column">
        <div class="footer-col-label">Categories</div>
        <div class="footer-category-links">
          {footerCats.map(([slug, category]) => <a href={`/category/${slug}/`}><span aria-hidden="true">{ICONS[slug]}</span>{category.label}</a>)}
        </div>
      </div>
      <div class="footer-resource-column">
        <div class="footer-col-label">Explore</div>
        <div class="footer-links">
          <a href="/tools/">Browse All Tools</a>
          <a href="/categories/">Browse Categories</a>
          <a href="/submit/">Submit a Tool</a>
          <a href="/about/">About the Directory</a>
          <a href="/about/#method">How We Curate</a>
        </div>
      </div>
    </div>
    <div class="footer-bar">
      <div class="footer-bar-inner">
        <span>© {currentYear} {SITE_NAME}. All rights reserved.</span>
        <span class="right">Independent directory · Not affiliated with X Corp.</span>
      </div>
    </div>
  </footer>
</div>

<script>
  const headerSearch = document.getElementById('headerSearch') as HTMLInputElement;
  headerSearch?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && headerSearch.value.trim()) {
      location.href = '/tools/?q=' + encodeURIComponent(headerSearch.value.trim());
    }
  });
</script>
</body>
</html>
