---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { CATS, TOOLS } from '../../data/tools.js';
import { SITE_NAME } from '../../config.js';

export function getStaticPaths() {
  return TOOLS.map(t => ({ params: { slug: t.id }, props: { tool: t } }));
}

const { tool: t } = Astro.props;
const cat = CATS[t.cat];
const related = TOOLS.filter(x => x.cat === t.cat && x.id !== t.id)
  .sort((a, b) => b.users - a.users).slice(0, 3);
const domain = (t.url || '').replace(/^https?:\/\//, '').replace(/\/$/, '');
// Homepage screenshot captured via Firecrawl (see .firecrawl/batch.sh); pages
// without one fall back to the placeholder so a failed capture never blocks a build.
const hasScreenshot = fs.existsSync(`public/screenshots/${t.id}.jpg`);

const title = `${t.name} — ${cat.label} Tool for X | ${SITE_NAME}`;
const description = `${t.tagline} ${t.name} review: pricing (${t.price.toLowerCase()}), key features and the best alternatives in ${cat.label.toLowerCase()} for X.`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: t.name,
    description: t.desc,
    url: t.url,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: t.price === 'Free' ? '0' : undefined, description: `${t.price} pricing` }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/tools/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(`/category/${t.cat}/`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: t.name, item: new URL(`/tools/${t.id}/`, Astro.site).toString() }
    ]
  }
];
---
<Base title={title} description={description} jsonld={jsonld} ogImage={hasScreenshot ? `/screenshots/${t.id}.jpg` : undefined}>
<main class="page-detail">
  <a class="back-link" href={`/category/${t.cat}/`}>← Back to directory</a>
  <div class="detail-card">
    <div class="detail-tile" style={`background:${t.color}`}>{t.name.charAt(0).toUpperCase()}</div>
    <div class="detail-head">
      <div class="detail-title-row">
        <h1>{t.name}</h1>
        {t.verified && <span class="badge-verified-lg">✓</span>}
        {t.featured && <span class="badge-featured-lg">★ Featured</span>}
      </div>
      <p class="detail-tagline">{t.tagline}</p>
    </div>
    <div class="detail-cta">
      <a class="btn-visit" href={t.url || '#'} target="_blank" rel="noopener">Visit {domain} ↗</a>
    </div>
  </div>

  <div class="detail-layout">
    <div>
      <h2>About {t.name}</h2>
      <p>{t.desc}</p>
      <h2 class="spaced">Key features</h2>
      <div class="features-grid">
        {t.features.map(f => (
          <div class="feature-item">
            <span class="check">✓</span>
            <span class="text">{f}</span>
          </div>
        ))}
      </div>
      <h2 class="spaced">Preview</h2>
      {hasScreenshot ? (
        <img
          class="preview-img"
          src={`/screenshots/${t.id}.jpg`}
          alt={`${t.name} homepage — ${t.tagline}`}
          width="1200"
          height="675"
          loading="lazy"
        />
      ) : (
        <div class="preview-box"><span>product screenshot — {t.name}</span></div>
      )}
    </div>
    <aside class="detail-aside">
      <div class="facts-card">
        <div class="aside-label">Quick facts</div>
        <div class="facts-list">
          <div class="fact-row"><span class="k">Category</span><a class="v" style={`color:${cat.color}`} href={`/category/${t.cat}/`}>{cat.label}</a></div>
          <div class="fact-row"><span class="k">Pricing</span><span class="v">{t.price}</span></div>
        </div>
      </div>
      <div class="bestfor-card">
        <div class="title">Best for</div>
        <p>{t.best}</p>
      </div>
      <a class="claim-card" href="/submit/" style="text-decoration:none;display:block">Own this tool? <span class="cta">Suggest an update →</span></a>
    </aside>
  </div>

  <div class="alternatives">
    <h2>Alternatives in {cat.label}</h2>
    <div class="grid-tools">
      {related.map(r => <ToolCard tool={r} />)}
    </div>
  </div>
</main>
</Base>
