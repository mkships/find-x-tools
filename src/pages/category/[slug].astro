---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { compareTools, CATS, ICONS, TOOLS } from '../../data/tools.js';
import { SITE_NAME } from '../../config.js';
import {
  BadgeCheck,
  ChevronDown,
  ChevronRight,
  CreditCard,
  Gift,
  Layers,
  LayoutGrid,
  Star
} from '@lucide/astro';

export function getStaticPaths() {
  return Object.keys(CATS).map(slug => ({ params: { slug } }));
}

const categoryContent = {
  content: {
    description: 'Write stronger posts and threads, develop ideas, and publish consistently on X.',
    overview: 'Writing consistently on X takes more than a blank composer. Content writing tools help you find angles, sharpen hooks, structure threads, preserve your voice, and turn rough ideas into posts worth publishing. Whether you are building a personal brand or managing a content calendar, these tools reduce the friction between an idea and a finished post.'
  },
  growth: {
    description: 'Build a relevant audience, find growth opportunities, and turn attention into engagement.',
    overview: 'Sustainable growth on X comes from reaching the right people and understanding what makes them engage. Growth and audience tools help you research followers, discover relevant accounts, identify high-intent conversations, and measure whether your audience is becoming more valuable—not merely larger.'
  },
  schedule: {
    description: 'Plan, schedule, automate, and recycle your X content from one reliable workflow.',
    overview: 'Scheduling and automation tools make consistent publishing possible without keeping you tied to the timeline. They help plan campaigns, queue posts and threads, recycle evergreen ideas, coordinate approvals, and publish at useful times. The right workflow gives creators and teams more time to engage while their content calendar stays on track.'
  },
  analytics: {
    description: 'Track reach, engagement, audience growth, and the posts that perform best on X.',
    overview: 'Native metrics only tell part of the story. X analytics tools add historical trends, clearer engagement reporting, audience insight, competitor comparisons, and campaign-level measurement. They help creators and teams understand what drives growth, when their audience is active, and which content deserves to be repeated or improved.'
  },
  ai: {
    description: 'Draft thoughtful replies, automate conversations, and engage more efficiently with AI.',
    overview: 'Reply and engagement tools help you participate in more relevant conversations without losing your voice. They can surface high-intent posts, draft contextual replies, organize target accounts, and automate carefully scoped interactions. Used thoughtfully, they reduce repetitive work while keeping genuine engagement at the center of your X strategy.'
  },
  design: {
    description: 'Create polished graphics, screenshots, videos, and branded media designed for X.',
    overview: 'Strong visuals make posts easier to understand and more likely to stop the scroll. Design and media tools help create branded graphics, beautify screenshots, produce short videos, and repurpose content for X without requiring a full design workflow. They are useful for creators and teams that need consistent visual quality at speed.'
  },
  audit: {
    description: 'Review follower quality, clean up your account, and strengthen your X profile.',
    overview: 'Profile audit tools reveal issues that are difficult to spot from the timeline alone. They help identify inactive or suspicious followers, review account health, evaluate profile conversion, and clean up outdated connections or content. These checks create a stronger foundation before you invest more time in publishing and growth.'
  },
  comments: {
    description: 'Save, organize, search, and revisit valuable posts and ideas from X.',
    overview: 'Bookmarks become much more useful when they can be searched, tagged, and organized. Bookmark and save tools turn scattered posts into a practical research library for content ideas, references, customer insight, and inspiration. They help you recover what you saved and put it back to work.'
  },
  bio: {
    description: 'Turn your X profile link into a focused destination for your work, offers, and audience.',
    overview: 'A bio-link page gives your audience one clear destination for everything you want to share. These tools combine multiple links, products, lead capture, media kits, and click analytics in a mobile-friendly page. They are especially useful when your X profile needs to support several projects or conversion paths.'
  },
  listening: {
    description: 'Monitor mentions, keywords, competitors, and relevant conversations across X.',
    overview: 'Social listening tools help you see the conversations that matter beyond direct notifications. They track brand mentions, keywords, competitors, sentiment, and emerging topics so you can respond earlier and understand how the market is moving. This is useful for reputation management, research, support, and proactive engagement.'
  }
};

const categoryFaqs = {
  content: [
    {
      question: 'What makes a writing tool useful specifically for X?',
      answer: 'Look for an editor that understands short posts, connected threads, previews, media, and X-native publishing. A generic AI writer can help with a first draft, but it may not support thread structure, character limits, or the final publishing workflow.'
    },
    {
      question: 'Should I choose a drafting tool or an all-in-one publishing tool?',
      answer: 'Choose a focused drafting tool if you mainly need better ideas, hooks, and rewrites. Choose an all-in-one tool if you also need scheduling, approvals, analytics, or a shared content calendar. The best option is the smallest workflow you will use consistently.'
    },
    {
      question: 'Can an AI writing tool preserve my voice?',
      answer: 'It can get closer when you can provide examples, save style guidance, and edit every draft before publishing. Treat generated copy as a starting point: original observations, specific details, and a final human pass are what keep the result recognizably yours.'
    },
    {
      question: 'What should I test before paying for an X writing tool?',
      answer: 'Draft a real post and a multi-post thread, then check the preview, media handling, autosave, export, and publishing flow. If you work with a team, also test comments, approvals, permissions, and how easily drafts move between collaborators.'
    }
  ],
  growth: [
    {
      question: 'What should an X growth tool help me improve?',
      answer: 'A useful growth tool should help you find relevant people, understand which posts attract them, and turn that insight into repeatable engagement. Prioritize audience quality, profile visits, meaningful replies, and conversions over follower count alone.'
    },
    {
      question: 'Are automated growth tools safe to use on X?',
      answer: 'Automation carries risk when it imitates people at scale through follows, likes, replies, or direct messages. Prefer tools that support research, planning, and human-approved actions, and confirm the provider’s current approach against X’s rules before connecting your account.'
    },
    {
      question: 'Which metrics show that my audience is improving?',
      answer: 'Track relevant follower growth alongside profile visits, reply quality, repeat engagers, link clicks, and conversions. A smaller audience that consistently responds or buys is usually more valuable than a larger audience built from low-intent follows.'
    },
    {
      question: 'How do I compare X audience tools?',
      answer: 'Compare the accounts and history included, discovery filters, export options, team features, and the actions the tool takes on your behalf. Test it with one concrete goal—such as finding prospective customers or analyzing new followers—before expanding the workflow.'
    }
  ],
  schedule: [
    {
      question: 'When is a third-party X scheduler worth using?',
      answer: 'A scheduler becomes useful when you plan more than a few posts ahead, publish threads, manage several accounts, or need approvals and a shared calendar. X’s native scheduler may be enough for a simple, single-account queue.'
    },
    {
      question: 'What should I test in an X scheduling tool?',
      answer: 'Test a post with media, a thread, a reschedule, and a failed or disconnected account. Check time-zone handling, previews, notifications, and whether the tool clearly reports publishing errors instead of silently dropping a post.'
    },
    {
      question: 'Can scheduling hurt engagement on X?',
      answer: 'Scheduling itself is not the problem; publishing without being available to respond can be. Use the queue for consistency, then leave room for timely posts and real conversation when your audience starts replying.'
    },
    {
      question: 'How much automation should I use?',
      answer: 'Automate predictable work such as queues, approvals, reminders, and evergreen resurfacing. Keep replies, sensitive announcements, and context-dependent posts under human review, and regularly remove recycled content that no longer feels current.'
    }
  ],
  analytics: [
    {
      question: 'What can an X analytics tool show beyond native analytics?',
      answer: 'Third-party tools can add longer history, searchable post archives, cleaner comparisons, custom date ranges, exports, and reporting across accounts. The exact benefit depends on how much history the tool can access and retain after you connect it.'
    },
    {
      question: 'Which X metrics are most useful?',
      answer: 'Start with impressions, engagement rate, profile visits, follower growth, link clicks, and the outcomes tied to your goal. Review them by content type and over time rather than judging a strategy from one unusually strong or weak post.'
    },
    {
      question: 'How much historical data will I get?',
      answer: 'History varies by provider, plan, and X data access. Some tools begin collecting only after connection, while others can import earlier posts. Confirm the lookback window, retention period, and export limits before choosing a plan.'
    },
    {
      question: 'What should teams look for in an analytics tool?',
      answer: 'Look for shared dashboards, consistent metric definitions, account-level permissions, scheduled reports, annotations, and exports. A good team tool should make it easy to explain what changed and connect performance to campaigns or publishing decisions.'
    }
  ],
  ai: [
    {
      question: 'How should AI support replies without making them generic?',
      answer: 'Use AI to surface relevant conversations, summarize context, and propose a starting point. Add your own opinion, experience, or question before posting; a fast reply that contributes nothing is unlikely to build a useful relationship.'
    },
    {
      question: 'Should an AI engagement tool post automatically?',
      answer: 'Human approval is the safer default, especially for replies and direct messages. If a tool offers automatic posting, check its controls, rate limits, exclusions, audit trail, and how it handles sensitive or ambiguous conversations.'
    },
    {
      question: 'What is a good first use case for an AI engagement tool?',
      answer: 'Start with a narrow workflow such as monitoring a small account list, triaging mentions, or drafting replies to inbound questions. Measure time saved and conversation quality before widening the audience or increasing automation.'
    },
    {
      question: 'How do I evaluate the quality of AI-generated replies?',
      answer: 'Check whether the reply understands the original post, adds a specific point, matches your tone, and would still be worth reading without the surrounding automation. Reject repetitive praise, invented facts, and replies designed only to attract attention.'
    }
  ],
  design: [
    {
      question: 'What makes a design tool a good fit for X?',
      answer: 'It should make common X formats quick to produce: image posts, quote cards, screenshots, short video, and reusable branded templates. Useful tools also preview crops clearly and export sharp files without adding unnecessary production steps.'
    },
    {
      question: 'Do I need X-specific templates?',
      answer: 'Templates help with speed and sizing, but they should be easy to adapt to your own visual system. Prioritize flexible layouts, readable typography, and consistent brand controls over a large library of designs that look like everyone else’s.'
    },
    {
      question: 'What should I check before exporting a visual?',
      answer: 'Check mobile legibility, crop safety, contrast, file size, and whether text remains readable in the timeline. Also confirm the exported format and resolution suit the type of post you plan to publish.'
    },
    {
      question: 'When is a dedicated media tool better than a general design app?',
      answer: 'Choose a dedicated tool when one repeated task—such as beautifying screenshots, turning posts into cards, or captioning clips—takes too long in a general editor. Keep the general app when you need broader layout control or complex brand systems.'
    }
  ],
  audit: [
    {
      question: 'What does an X profile audit usually check?',
      answer: 'Depending on the tool, an audit may review profile clarity, posting patterns, engagement, follower quality, inactive connections, or suspicious accounts. Check whether the result is based on live account data, public signals, or a simple checklist.'
    },
    {
      question: 'Can a profile audit tool remove followers or old posts?',
      answer: 'Some tools only report issues; others can take actions after you connect your account. Review permissions carefully, prefer a preview before bulk changes, and export or back up anything important before removing followers, follows, or posts.'
    },
    {
      question: 'How often should I audit my X account?',
      answer: 'A quarterly review is enough for many creators. Audit sooner after a large growth campaign, a change in positioning, unusual follower activity, or when profile visits rise without a corresponding increase in relevant follows or conversions.'
    },
    {
      question: 'What should I do with an audit score?',
      answer: 'Use the score as a prompt, not a verdict. Focus on the underlying evidence, fix the few issues most likely to affect trust or conversion, and compare results over time rather than optimizing for a proprietary number.'
    }
  ],
  comments: [
    {
      question: 'Why use a bookmark tool instead of X bookmarks alone?',
      answer: 'A dedicated tool can add full-text search, tags, folders, notes, exports, and resurfacing. It is most valuable when saved posts are part of a real research, writing, or customer-insight workflow rather than a list you rarely revisit.'
    },
    {
      question: 'Can these tools import my existing X bookmarks?',
      answer: 'Import support varies and may depend on X data access, a browser extension, or a manual export. Confirm whether the tool imports older bookmarks, preserves media and threads, and keeps syncing after the first import.'
    },
    {
      question: 'How should I organize saved posts?',
      answer: 'Start with a small set of action-oriented groups such as ideas to develop, examples to reference, people to contact, and research to read. Add notes when you save something so your future self knows why it mattered.'
    },
    {
      question: 'What should I check for privacy and portability?',
      answer: 'Review what account access the tool requests, whether saved content is private by default, and how to delete your data. Prefer a tool that can export links, notes, and tags in a useful format if you decide to leave.'
    }
  ],
  bio: [
    {
      question: 'When does an X profile need a bio-link page?',
      answer: 'Use one when a single profile URL needs to serve several destinations—such as a product, newsletter, booking page, portfolio, or lead magnet. If you have one clear conversion goal, linking directly to that page may be simpler and stronger.'
    },
    {
      question: 'What should a good bio-link tool include?',
      answer: 'Prioritize fast mobile loading, clear hierarchy, custom branding, link scheduling, basic analytics, and an easy way to update the page. Commerce, email capture, and embeds matter only if they support the action you want visitors to take.'
    },
    {
      question: 'Do custom domains matter for a bio-link page?',
      answer: 'A custom domain can strengthen trust, brand recall, and portability, but it is not essential for a simple page. Check whether the plan supports your domain, analytics setup, redirects, and removing the provider’s branding.'
    },
    {
      question: 'How should I measure a bio-link page?',
      answer: 'Track profile-link visits, click-through rate, and the downstream action that matters—such as a signup, purchase, or booking. Use those results to simplify the page; more links do not necessarily create more value.'
    }
  ],
  listening: [
    {
      question: 'How is social listening different from checking X mentions?',
      answer: 'Mentions show posts that tag your account. Social listening can also track untagged brand names, product terms, competitors, customer problems, and topic keywords, giving you a broader view of conversations you might otherwise miss.'
    },
    {
      question: 'What should I monitor first?',
      answer: 'Begin with your brand and product names, common misspellings, a few high-intent problem phrases, and key competitors. Keep the query set narrow until you understand the noise, then add exclusions and new terms deliberately.'
    },
    {
      question: 'Are X listening results real time?',
      answer: 'Speed depends on the provider, plan, query volume, and its access to X data. If rapid response matters, test the delay with a known post and confirm alert channels, refresh frequency, historical coverage, and any result caps.'
    },
    {
      question: 'How do I choose between listening tools?',
      answer: 'Compare query flexibility, source coverage, alert speed, sentiment quality, history, exports, and collaboration features. Evaluate the tool with your own keywords because a clean demo query may not reflect the noise in your market.'
    }
  ]
};

const { slug } = Astro.params;
const cat = CATS[slug];
const content = categoryContent[slug];
const tools = TOOLS.filter(tool => tool.categories.includes(slug))
  .sort(compareTools);
const categoryToolsLabel = /\btools$/i.test(cat.label) ? cat.label : `${cat.label} Tools`;
const otherCategories = Object.entries(CATS)
  .filter(([key]) => key !== slug)
  .sort(([, a], [, b]) => a.label.localeCompare(b.label));
const freePlanCount = tools.filter(tool => tool.price === 'Free' || tool.price === 'Freemium').length;
const testedCount = tools.filter(tool => tool.tested).length;

const filters = [
  { value: 'All', label: 'All Tools', Icon: LayoutGrid },
  { value: 'Free', label: 'Free', Icon: Gift },
  { value: 'Freemium', label: 'Freemium', Icon: Layers },
  { value: 'Paid', label: 'Paid', Icon: CreditCard },
  { value: 'Editor', label: "Editor's Pick", Icon: Star }
];

const faqs: Array<{ question: string; answer: string }> = categoryFaqs[slug];

const title = `Best ${categoryToolsLabel} for X (${tools.length}) | ${SITE_NAME}`;
const description = `Compare the ${tools.length} best ${categoryToolsLabel.toLowerCase()} for X — ${tools.slice(0, 3).map(tool => tool.name).join(', ')} and more. Pricing and key features, hand-curated.`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${cat.label} tools for X`,
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: tool.name,
      url: new URL(`/tools/${tool.id}/`, Astro.site).toString()
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: cat.label, item: new URL(`/category/${slug}/`, Astro.site).toString() }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer
      }
    }))
  }
];
---
<Base title={title} description={description} jsonld={jsonld}>
  <main class="category-landing">
    <section class="category-landing-hero">
      <div class="category-landing-hero-inner">
        <nav class="breadcrumbs category-breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
          <a href="/tools/">Tools</a>
          <ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
          <span aria-current="page">{cat.label}</span>
        </nav>

        <div class="category-hero-content">
          <div class="category-hero-icon" aria-hidden="true">{ICONS[slug]}</div>
          <div>
            <h1>Best {categoryToolsLabel} for X</h1>
            <p>{content.description}</p>
            <div class="category-hero-stats" aria-label="Category statistics">
              <span>🛠️ {tools.length} tool{tools.length === 1 ? '' : 's'}</span>
              <span>🎁 {freePlanCount} with free plans</span>
              <span><BadgeCheck size={14} stroke-width={2} aria-hidden="true" /> {testedCount} tested</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="category-landing-body">
      <section class="category-overview" aria-label={`About ${cat.label} tools`}>
        <p>{content.overview}</p>
      </section>

      <section class="category-tools" aria-labelledby="category-tools-title">
        <div class="category-section-heading">
          <h2 id="category-tools-title">Explore {categoryToolsLabel}</h2>
        </div>
        <div class="toolbar category-filter-toolbar">
          <div class="seg category-filter-seg" id="categoryFilters" aria-label="Filter category tools">
            {filters.map(({ value, label, Icon }) => (
              <button
                type="button"
                class={`seg-btn${value === 'All' ? ' active' : ''}`}
                data-filter={value}
                aria-pressed={value === 'All' ? 'true' : 'false'}
              >
                <Icon
                  size={14}
                  stroke-width={value === 'Editor' ? 2.1 : 1.9}
                  fill={value === 'Editor' ? 'currentColor' : 'none'}
                  aria-hidden="true"
                />
                {label}
              </button>
            ))}
          </div>
          <span class="count-label" id="categoryToolsCount">{tools.length} tool{tools.length === 1 ? '' : 's'}</span>
        </div>

        <div class="grid-tools" id="categoryToolsGrid">
          {tools.map(tool => <ToolCard tool={tool} />)}
        </div>
        <div class="empty-state hidden" id="categoryEmptyState">
          <div class="title">No tools match this filter</div>
          <p>Try another pricing option or view all tools in this category.</p>
          <button class="hero-action hero-action-secondary" id="resetCategoryFilter" type="button">View All Tools</button>
        </div>
      </section>

      <section class="category-faq" aria-labelledby="category-faq-title">
        <h2 id="category-faq-title">Questions about {categoryToolsLabel}</h2>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span>{faq.question}</span>
                <ChevronDown size={18} stroke-width={2} aria-hidden="true" />
              </summary>
              <div class="faq-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section class="other-categories" aria-labelledby="other-categories-title">
        <h2 id="other-categories-title">Browse Other Categories</h2>
        <div class="other-category-list">
          {otherCategories.map(([key, category]) => (
            <a href={`/category/${key}/`}>
              <span aria-hidden="true">{ICONS[key]}</span>
              {category.label}
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script>
    const filterGroup = document.getElementById('categoryFilters')!;
    const grid = document.getElementById('categoryToolsGrid')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tool-card'));
    const count = document.getElementById('categoryToolsCount')!;
    const emptyState = document.getElementById('categoryEmptyState')!;

    function applyCategoryFilter(filter: string) {
      let visible = 0;
      cards.forEach(card => {
        const show = filter === 'All'
          || (filter === 'Editor' && card.dataset.editorPick === 'true')
          || card.dataset.price === filter;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      filterGroup.querySelectorAll<HTMLElement>('[data-filter]').forEach(button => {
        const active = button.dataset.filter === filter;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      count.textContent = visible + ' tool' + (visible === 1 ? '' : 's');
      grid.classList.toggle('hidden', visible === 0);
      emptyState.classList.toggle('hidden', visible > 0);

      const params = new URLSearchParams(location.search);
      if (filter === 'All') params.delete('filter');
      else params.set('filter', filter.toLowerCase());
      const query = params.toString();
      history.replaceState(null, '', location.pathname + (query ? '?' + query : ''));
    }

    filterGroup.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-filter]');
      if (button?.dataset.filter) applyCategoryFilter(button.dataset.filter);
    });

    document.getElementById('resetCategoryFilter')!.addEventListener('click', () => applyCategoryFilter('All'));

    const initialFilter = new URLSearchParams(location.search).get('filter');
    const matchingFilter = ['free', 'freemium', 'paid', 'editor'].find(value => value === initialFilter);
    if (matchingFilter) {
      applyCategoryFilter(matchingFilter === 'editor'
        ? 'Editor'
        : matchingFilter.charAt(0).toUpperCase() + matchingFilter.slice(1));
    }
  </script>
</Base>
