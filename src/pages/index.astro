---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import CategorySidebar from '../components/CategorySidebar.astro';
import { compareTools, JOBS, TOOLS } from '../data/tools.js';
import { SITE_NAME } from '../config.js';
import { ArrowRight, BadgeCheck, CalendarPlus, ChartNoAxesCombined, ExternalLink, FolderOpen, Gauge, MessageCircle, PenLine, Rocket } from '@lucide/astro';

const JOB_STACKS = [
  { label: 'Create & publish content', icon: PenLine, jobs: ['write', 'schedule', 'visuals'] },
  { label: 'Engage your network', icon: MessageCircle, jobs: ['engage', 'dms', 'agents'] },
  { label: 'Analyze your growth', icon: ChartNoAxesCombined, jobs: ['analytics', 'listen'] },
  { label: 'Organize posts & saves', icon: FolderOpen, jobs: ['bookmarks', 'clean'] }
] as const;

const xNativeTools = [...TOOLS].filter(tool => tool.status === 'live' && tool.xFit === 'high')
  .sort((a, b) => Number(Boolean(b.editorPick)) - Number(Boolean(a.editorPick))
    || (a.editorPickOrder ?? 999) - (b.editorPickOrder ?? 999)
    || compareTools(a, b));
const xNativePreview = xNativeTools.slice(0, 6);
const orderableTools = TOOLS.filter(tool => tool.status === 'live' && tool.xFit !== 'low');
const bestFit = [...orderableTools].sort(compareTools).slice(0, 9);
const recent = [...orderableTools]
  .sort((a, b) => String(b.addedAt || '').localeCompare(String(a.addedAt || '')) || compareTools(a, b))
  .slice(0, 9);
const ninetyDaysAgo = new Date();
ninetyDaysAgo.setUTCDate(ninetyDaysAgo.getUTCDate() - 90);
const shipped = TOOLS.filter(tool => tool.status === 'live' && tool.demoPostUrl && tool.launchedAt && new Date(`${tool.launchedAt}T00:00:00Z`) >= ninetyDaysAgo)
  .sort((a, b) => (a.shippedOnXOrder ?? 999) - (b.shippedOnXOrder ?? 999) || String(b.launchedAt).localeCompare(String(a.launchedAt)))
  .slice(0, 8);
const formatDate = (date: string) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));

const title = `${SITE_NAME} — Grow, engage and monetise your audience on X`;
const description = `Discover, compare and pick the best tools for content writing, growth, scheduling, analytics and engagement on X. Hand-curated directory of X-native tools.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: new URL('/tools/?q={search_term_string}', Astro.site).toString() },
    'query-input': 'required name=search_term_string'
  }
};
---
<Base title={title} description={description} jsonld={jsonld}>
<main>
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <div class="hero-badge">🚀 Hand-curated from 100s of X tools</div>
      <h1>
        <span class="hero-title-line">Every tool to grow and monetise</span>
        <span class="hero-title-line">your audience on <span class="grad-text">X, in one place.</span></span>
      </h1>
      <p>Know what you need? Search by tool or use case.</p>
      <form class="hero-search" action="/tools/" method="get" role="search">
        <input name="q" placeholder="Search by tool or use case" aria-label="Search X tools" />
        <button type="submit">Search tools</button>
      </form>
      <div class="hero-actions">
        <a class="hero-action hero-action-primary" href="/tools/">Browse all tools</a>
        <a class="hero-action hero-action-secondary" href="/submit/">Submit a Tool</a>
      </div>
      <nav class="hero-workflow-nav" aria-label="Browse X tools by workflow">
        <p class="hero-workflow-label">Not sure where to start? Browse by workflow</p>
        <div class="home-workflow-grid">
          {JOB_STACKS.map(stack => {
            const StackIcon = stack.icon;
            return <div class="home-workflow-card">
              <div class="home-discovery-heading"><span><StackIcon size={15} aria-hidden="true" /></span><b>{stack.label}</b></div>
              <div class="home-discovery-links">{stack.jobs.map((slug: keyof typeof JOBS) => <a href={`/tools/?job=${slug}`}>{JOBS[slug].label}</a>)}</div>
            </div>;
          })}
        </div>
      </nav>
    </div>
  </section>

  {shipped.length > 0 && <section class="home-curated-section">
    <div class="home-section-heading"><div><span>Fresh demos</span><h2>Shipped on X</h2><p>Recent launches and product demos, manually selected from X.</p></div><Rocket size={22} aria-hidden="true" /></div>
    <div class="shipped-grid">
      {shipped.map(tool => <article class="shipped-card">
        {tool.demoImage && <img src={tool.demoImage} alt="" loading="lazy" />}
        <div class="shipped-card-head">
          <span class="shipped-card-icon" style={`background:${tool.color}`}><img src={tool.icon} alt="" loading="lazy" /></span>
          <div class="shipped-card-identity"><p class="shipped-meta">{tool.founderHandle ? `@${tool.founderHandle}` : tool.name}</p><h3>{tool.name}</h3></div>
          <time class="shipped-date" datetime={tool.launchedAt}>{formatDate(tool.launchedAt)}</time>
        </div>
        <p class="shipped-summary">{tool.demoSummary || tool.tagline}</p>
        <div class="shipped-actions"><a href={`/tools/${tool.id}/`}>View listing</a><a href={tool.demoPostUrl} target="_blank" rel="noopener">View post<ExternalLink size={13} /></a></div>
      </article>)}
    </div>
  </section>}

  {xNativePreview.length > 0 && <section class="home-curated-section">
    <div class="home-section-heading"><div><span>Built for X</span><h2>X-native highlights</h2><p>A focused selection from {xNativeTools.length} live tools with X at the core of the product.</p></div><BadgeCheck size={22} aria-hidden="true" /></div>
    <div class="grid-tools">{xNativePreview.map(tool => <ToolCard tool={tool} />)}</div>
    <div class="view-all-wrap">
      <a class="btn-view-all btn-view-all-link" href="/tools/?filter=x-native">
        View all {xNativeTools.length} X-native tools
        <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
      </a>
    </div>
  </section>}

  <section class="section-home-main">
    <div class="layout-sidebar">
      <CategorySidebar active="all" />
      <div class="home-order-region">
        <div class="toolbar">
          <div class="seg" role="radiogroup" aria-label="Tool ordering">
            <input class="home-order-radio" id="homeOrderBest" type="radio" name="home-order" checked />
            <label class="seg-btn" for="homeOrderBest">
              <Gauge size={16} stroke-width={2} aria-hidden="true" />
              Best fit for X
            </label>
            <input class="home-order-radio" id="homeOrderRecent" type="radio" name="home-order" />
            <label class="seg-btn" for="homeOrderRecent">
              <CalendarPlus size={16} stroke-width={2} aria-hidden="true" />
              Recently added
            </label>
          </div>
          <span class="count-label">{TOOLS.length} tools</span>
        </div>
        <div class="grid-tools home-order-panel-best">
          {bestFit.map(t => <ToolCard tool={t} />)}
        </div>
        <div class="grid-tools home-order-panel-recent">
          {recent.map(t => <ToolCard tool={t} />)}
        </div>
        <div class="view-all-wrap">
          <a class="btn-view-all btn-view-all-link" href="/tools/">
            View All Tools
            <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

</main>

</Base>
