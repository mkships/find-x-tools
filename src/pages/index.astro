---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import CategorySidebar from '../components/CategorySidebar.astro';
import { CATS, TOOLS } from '../data/tools.js';
import { SITE_NAME } from '../config.js';

const heroChips = Object.keys(CATS).slice(0, 6);
const featured = TOOLS.filter(t => t.featured).slice(0, 3);
const picks = [...TOOLS].sort((a, b) => b.users - a.users).slice(0, 9);

const title = `${SITE_NAME} — Every tool to grow on X, in one place`;
const description = `Discover, compare and pick the best tools for content, growth, scheduling, analytics and engagement on X. Hand-curated directory of ${TOOLS.length} X-native tools.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: new URL('/tools/?q={search_term_string}', Astro.site).toString() },
    'query-input': 'required name=search_term_string'
  }
};
---
<Base title={title} description={description} jsonld={jsonld}>
<main>
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <div class="hero-badge">🚀 {TOOLS.length} X-native tools, hand-curated</div>
      <h1>Every tool to grow<br />on <span class="grad-text">X, in one place</span></h1>
      <p>Discover, compare and pick the best tools for content, growth, scheduling, analytics and engagement on X.</p>
      <div class="hero-search">
        <input id="heroSearch" placeholder="Search X tools — e.g. Content Writing, Scheduling, Analytics…" aria-label="Search X tools" />
        <button id="heroSearchBtn">Search</button>
      </div>
      <div class="hero-chips">
        {heroChips.map(k => <a class="hero-chip" href={`/category/${k}/`}>{CATS[k].label}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Featured tools</h2>
      <a class="link-view-all" href="/tools/">View all →</a>
    </div>
    <div class="grid-featured">
      {featured.map(t => <ToolCard tool={t} />)}
    </div>
  </section>

  <section class="section-home-main">
    <div class="layout-sidebar">
      <CategorySidebar active="" />
      <div>
        <div class="toolbar">
          <div class="seg">
            <span class="seg-btn active">⭐ Editorial Picks</span>
          </div>
          <span class="count-label">{TOOLS.length} tools</span>
        </div>
        <div class="grid-tools">
          {picks.map(t => <ToolCard tool={t} />)}
        </div>
        <div style="margin-top:28px;text-align:center">
          <a class="btn-view-all btn-view-all-link" href="/tools/">View all {TOOLS.length} tools →</a>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  const heroInput = document.getElementById('heroSearch') as HTMLInputElement;
  const go = () => {
    const q = heroInput.value.trim();
    location.href = q ? '/tools/?q=' + encodeURIComponent(q) : '/tools/';
  };
  document.getElementById('heroSearchBtn')!.addEventListener('click', go);
  heroInput.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });

</script>
</Base>
