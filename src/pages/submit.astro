---
import Base from '../layouts/Base.astro';
import { CATS } from '../data/tools.js';
import { SITE_NAME } from '../config.js';
import { ArrowRight, CircleCheckBig, ChevronRight } from '@lucide/astro';

const title = `Submit a Tool | ${SITE_NAME}`;
const description = 'Suggest an X (Twitter) tool for the directory. We review submissions within 2–3 business days.';
const categoryEntries = Object.entries(CATS);
---
<Base title={title} description={description}>
  <main class="page-submit">
    <nav class="breadcrumbs submit-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
      <span aria-current="page">Submit a Tool</span>
    </nav>

    <header class="submit-head">
      <span>Suggest a listing</span>
      <h1>Submit a Tool</h1>
      <p>Know an X (Twitter) tool that should be listed here? Fill out the form below and we’ll review it within 2–3 business days.</p>
    </header>

    <section class="submit-form-card" aria-label="Tool submission form">
      <form id="submitForm" novalidate>
        <div class="submit-form-grid">
          <div class="submit-field">
            <label for="toolName">Tool Name <span aria-hidden="true">*</span></label>
            <input id="toolName" name="name" type="text" maxlength="120" placeholder="e.g. Typefully" autocomplete="organization" required />
            <p class="submit-field-error" data-error-for="toolName"></p>
          </div>

          <div class="submit-field">
            <label for="toolUrl">Website URL <span aria-hidden="true">*</span></label>
            <input id="toolUrl" name="url" type="url" maxlength="500" placeholder="https://example.com" inputmode="url" autocomplete="url" required />
            <p class="submit-field-error" data-error-for="toolUrl"></p>
          </div>

          <div class="submit-field submit-field-wide">
            <label for="toolDescription">Tool Description <span aria-hidden="true">*</span></label>
            <textarea id="toolDescription" name="desc" maxlength="2000" rows="6" placeholder="What does the tool do, and who is it best suited for?" required></textarea>
            <p class="submit-field-help">A concise, factual description helps us review the listing faster.</p>
            <p class="submit-field-error" data-error-for="toolDescription"></p>
          </div>

          <div class="submit-field">
            <label for="toolCategory">Category <span aria-hidden="true">*</span></label>
            <select id="toolCategory" name="cat" required>
              <option value="">Choose a category</option>
              {categoryEntries.map(([slug, category]) => <option value={slug}>{category.label}</option>)}
              <option value="other">Suggest a new category</option>
            </select>
            <p class="submit-field-error" data-error-for="toolCategory"></p>
          </div>

          <div class="submit-field">
            <label for="pricingModel">Pricing Model <span aria-hidden="true">*</span></label>
            <select id="pricingModel" name="price" required>
              <option value="">Choose a pricing model</option>
              <option value="Free">Free</option>
              <option value="Freemium">Freemium</option>
              <option value="Paid">Paid</option>
            </select>
            <p class="submit-field-error" data-error-for="pricingModel"></p>
          </div>

          <div class="submit-field submit-field-wide" id="customCategoryField" hidden>
            <label for="customCategory">Suggested Category <span aria-hidden="true">*</span></label>
            <input id="customCategory" name="customCategory" type="text" maxlength="80" placeholder="Enter a category name" />
            <p class="submit-field-error" data-error-for="customCategory"></p>
          </div>

          <div class="submit-field submit-field-wide">
            <label for="demoPostUrl">Launch or Demo Post on X <small>Optional</small></label>
            <input id="demoPostUrl" name="demoPostUrl" type="url" maxlength="500" placeholder="https://x.com/yourhandle/status/…" inputmode="url" />
            <p class="submit-field-help">A real product launch or demo post may be considered for the curated Shipped on X section.</p>
            <p class="submit-field-error" data-error-for="demoPostUrl"></p>
          </div>

          <div class="submit-field">
            <label for="xPrimary">Is X the primary product? <small>Optional</small></label>
            <select id="xPrimary" name="xPrimary"><option value="">Choose one</option><option value="yes">Yes — built primarily for X</option><option value="no">No — multi-network or adjacent</option></select>
          </div>

          <div class="submit-field">
            <label for="apiStatus">How does it access X? <small>Optional</small></label>
            <select id="apiStatus" name="apiStatus"><option value="">Choose one</option><option value="official">Official X API</option><option value="official-plus-other">Official API plus other data</option><option value="no-api">Extension or local — no API</option><option value="unclear">Not sure</option></select>
          </div>

          <div class="submit-field">
            <label for="networks">Other Networks <small>Optional</small></label>
            <input id="networks" name="networks" maxlength="300" placeholder="LinkedIn, Bluesky" />
          </div>

          <div class="submit-field">
            <label for="teamSize">Team Size <small>Optional</small></label>
            <select id="teamSize" name="teamSize"><option value="">Choose one</option><option value="solo">Solo founder</option><option value="small">2–10 people</option><option value="team">11+ people</option></select>
          </div>

          <div class="submit-field submit-field-wide">
            <label for="xJobs">Main Jobs on X <small>Optional</small></label>
            <input id="xJobs" name="xJobs" maxlength="500" placeholder="Writing threads, scheduling posts, analytics…" />
            <p class="submit-field-help">These are maker-supplied claims. We independently verify them before publishing.</p>
          </div>

          <div class="submit-field submit-field-wide">
            <label for="submitterEmail">Your Email <small>Optional</small></label>
            <input id="submitterEmail" name="email" type="email" maxlength="254" placeholder="you@company.com" autocomplete="email" />
            <p class="submit-field-help">We’ll only use this if we need to clarify the submission.</p>
            <p class="submit-field-error" data-error-for="submitterEmail"></p>
          </div>
        </div>

        <input class="submit-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-error" id="submitError" role="alert"></div>
        <div class="submit-form-actions">
          <button class="hero-action hero-action-primary submit-form-button" type="submit">
            <span>Submit for Review</span>
            <ArrowRight size={17} stroke-width={2} aria-hidden="true" />
          </button>
        </div>
      </form>

      <div class="success-card submit-success" id="submitSuccess" hidden>
        <div class="success-mark"><CircleCheckBig size={38} stroke-width={2} aria-hidden="true" /></div>
        <h2>Submission received</h2>
        <p>Thanks—your tool is now in our review queue. We’ll review it within 2–3 business days.</p>
        <div class="success-actions">
          <a class="hero-action hero-action-secondary" href="/tools/">Browse tools</a>
          <button class="hero-action hero-action-primary" id="submitAnother" type="button">Submit another</button>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('submitForm') as HTMLFormElement;
    const category = document.getElementById('toolCategory') as HTMLSelectElement;
    const customCategoryField = document.getElementById('customCategoryField') as HTMLElement;
    const customCategory = document.getElementById('customCategory') as HTMLInputElement;
    const submitError = document.getElementById('submitError') as HTMLElement;
    const submitSuccess = document.getElementById('submitSuccess') as HTMLElement;
    const submitAnother = document.getElementById('submitAnother') as HTMLButtonElement;
    const submitButton = form.querySelector<HTMLButtonElement>('.submit-form-button')!;

    function toggleCustomCategory() {
      const isCustom = category.value === 'other';
      customCategoryField.hidden = !isCustom;
      customCategory.required = isCustom;
      if (!isCustom) customCategory.value = '';
    }

    function clearErrors() {
      submitError.textContent = '';
      submitError.classList.remove('show');
      form.querySelectorAll('.is-invalid').forEach(field => {
        field.classList.remove('is-invalid');
        field.removeAttribute('aria-invalid');
      });
      form.querySelectorAll<HTMLElement>('.submit-field-error').forEach(error => { error.textContent = ''; });
    }

    function setFieldError(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string) {
      field.classList.add('is-invalid');
      field.setAttribute('aria-invalid', 'true');
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      if (error) error.textContent = message;
    }

    function validWebsite(value: string) {
      try {
        const parsed = new URL(value);
        return ['http:', 'https:'].includes(parsed.protocol) && parsed.hostname.includes('.');
      } catch {
        return false;
      }
    }

    function validateForm() {
      clearErrors();
      let valid = true;
      const name = document.getElementById('toolName') as HTMLInputElement;
      const url = document.getElementById('toolUrl') as HTMLInputElement;
      const description = document.getElementById('toolDescription') as HTMLTextAreaElement;
      const pricing = document.getElementById('pricingModel') as HTMLSelectElement;
      const email = document.getElementById('submitterEmail') as HTMLInputElement;
      const demoPostUrl = document.getElementById('demoPostUrl') as HTMLInputElement;

      if (!name.value.trim()) { setFieldError(name, 'Please enter the tool name.'); valid = false; }
      if (!validWebsite(url.value.trim())) { setFieldError(url, 'Enter a complete website URL, such as https://example.com.'); valid = false; }
      if (!description.value.trim()) { setFieldError(description, 'Please add a short description of the tool.'); valid = false; }
      if (!category.value) { setFieldError(category, 'Please choose a category.'); valid = false; }
      if (category.value === 'other' && !customCategory.value.trim()) { setFieldError(customCategory, 'Please enter your suggested category.'); valid = false; }
      if (!pricing.value) { setFieldError(pricing, 'Please choose a pricing model.'); valid = false; }
      if (email.value && !email.validity.valid) { setFieldError(email, 'Please enter a valid email address or leave this field blank.'); valid = false; }
      if (demoPostUrl.value && !/^https:\/\/(?:www\.)?(?:x|twitter)\.com\/[^/]+\/status\/\d+/.test(demoPostUrl.value.trim())) { setFieldError(demoPostUrl, 'Enter a complete X post URL.'); valid = false; }

      if (!valid) form.querySelector<HTMLElement>('.is-invalid')?.focus();
      return valid;
    }

    category.addEventListener('change', toggleCustomCategory);

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!validateForm()) return;

      const data = Object.fromEntries(new FormData(form).entries());
      data.cat = category.value === 'other' ? customCategory.value.trim() : category.value;
      delete data.customCategory;
      submitButton.disabled = true;
      submitButton.querySelector('span')!.textContent = 'Submitting…';

      try {
        const response = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Something went wrong. Please try again.');
        form.hidden = true;
        submitSuccess.hidden = false;
        submitSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        submitError.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        submitError.classList.add('show');
      } finally {
        submitButton.disabled = false;
        submitButton.querySelector('span')!.textContent = 'Submit for Review';
      }
    });

    submitAnother.addEventListener('click', () => {
      form.reset();
      clearErrors();
      toggleCustomCategory();
      form.hidden = false;
      submitSuccess.hidden = true;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Base>
