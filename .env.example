# Required for the private /admin/ editor
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required on Vercel so admin saves commit data and trigger a redeploy
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
GITHUB_TOKEN=github_pat_replace_me

# Existing site settings
SITE_URL=https://your-domain.example
SUBMISSIONS_WEBHOOK_URL=https://script.google.com/macros/s/replace-me/exec
